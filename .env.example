# =====================================================================
# Stock Predictor Agent — Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to git. (.gitignore already excludes it.)
# =====================================================================

# Which entry point reads what:
#   - Monthly email digest (src/main.py, src/agent.py, src/notifier.py): everything
#     below except the "Chat app (optional)" section.
#   - Chat app (src/api/app.py, src/api/chat.py): ANTHROPIC_API_KEY plus the
#     "Chat app (optional)" section. It ignores ANTHROPIC_MODEL.

# --- Anthropic (Claude) API ---
# Get from: https://console.anthropic.com/
# Set a monthly spending cap on the same dashboard for safety.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Model for the email digest only (src/agent.py).
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Gmail SMTP ---
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password:      https://myaccount.google.com/apppasswords
# 3. Paste the 16-char password below (with or without spaces — both work).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_TO=you@gmail.com

# --- Runtime config ---
# Set to "true" to skip sending email and just print to console.
DRY_RUN=true

# Path to the watchlist YAML
WATCHLIST_PATH=config/watchlist.yaml

# How many years of history to fetch for indicators/backtests
LOOKBACK_YEARS=2

# Output directory for generated reports
REPORTS_DIR=reports

# --- Chat app (optional) ---
# Read by src/api/app.py and src/api/chat.py. All have defaults; uncomment to override.
# CHAT_MODEL=claude-sonnet-5-5
# CHAT_EFFORT=medium
# CHAT_RATE_LIMIT=10/minute
# Comma-separated list of origins allowed to call the API (CORS).
# ALLOWED_ORIGINS=http://localhost:3000
