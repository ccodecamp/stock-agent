# =====================================================================
# Stock Predictor Agent — Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to git. (.gitignore already excludes it.)
# =====================================================================

# --- Anthropic (Claude) API ---
# Get from: https://console.anthropic.com/
# Set a monthly spending cap on the same dashboard for safety.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Gmail SMTP ---
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password:      https://myaccount.google.com/apppasswords
# 3. Paste the 16-char password below (with or without spaces — both work).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_TO=you@gmail.com

# --- Runtime config ---
# Set to "true" to skip sending email and just print to console.
DRY_RUN=true

# Path to the watchlist YAML
WATCHLIST_PATH=config/watchlist.yaml

# How many years of history to fetch for indicators/backtests
LOOKBACK_YEARS=2

# Output directory for generated reports
REPORTS_DIR=reports
